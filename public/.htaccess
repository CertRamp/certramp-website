# ─────────────────────────────────────────────────────────────────────────────
# CertRamp Learning — Apache settings for the static export (IONOS and others).
# Ignored by hosts that don't use Apache; harmless there.
# ─────────────────────────────────────────────────────────────────────────────

ErrorDocument 404 /404.html
DirectorySlash On
Options -Indexes

# Redirect www to the main host (HTTPS itself is handled by IONOS Deploy Now;
# checking %{HTTPS} here could loop behind their proxy).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.certramplearning\.com$ [NC]
  RewriteRule ^ https://certramplearning.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Open Graph images are written without a file extension.
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Long cache for fingerprinted build assets, short for pages.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
