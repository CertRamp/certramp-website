# Production build settings (public values — safe to commit).
# These are baked into the static files at build time.
NEXT_PUBLIC_SITE_URL=https://certramplearning.com

# Keep "false" until Impressum, Datenschutz and cookie texts are final.
# Set to "true" to let Google index the site.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Web analytics: Umami Cloud (cookieless). Stays OFF until the website ID is filled in.
# Umami → Settings → Websites → certramplearning.com → "Website ID".
# Setting the ID also switches the privacy policy and cookie page to the Umami texts.
NEXT_PUBLIC_ANALYTICS_PROVIDER=umami
NEXT_PUBLIC_UMAMI_WEBSITE_ID=686303bf-be81-40cf-bc6f-a553dcbce2d2

# Hide unfinished placeholder content on the live site (shown in development).
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
