# ─────────────────────────────────────────────────────────────────────────────
# CertRamp Learning — environment configuration
# Copy to `.env.local` for local development, and set the same variables in
# your hosting provider (e.g. Vercel → Project → Settings → Environment Variables).
#
# Everything here is OPTIONAL at build time. Missing values never produce fake
# links: the site shows a clearly marked "not yet available" state instead.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical production origin, no trailing slash. Used for canonical URLs,
# Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to "true" ONLY on the real production deployment. Anything else makes
# every page `noindex` and robots.txt disallow all crawlers — so previews and
# staging never get indexed by accident.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Analytics hook target. One of: none | gtm | ga4 | plausible
# The site never loads a tracking script itself. It only forwards events to a
# provider that you have loaded yourself (after consent, where required).
NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# ── ClassMarker URLs ─────────────────────────────────────────────────────────
# Per certification, the URL can live in src/config/certifications.ts OR be
# supplied here. The env var wins when both are set.
#
# Naming: CLASSMARKER_FREE_TEST_URL__<SLUG>  and  CLASSMARKER_PREMIUM_TEST_URL__<SLUG>
# where <SLUG> is the certification slug in UPPER_SNAKE_CASE.
# Example for slug "isaca-certification-placeholder":
#
# CLASSMARKER_FREE_TEST_URL__ISACA_CERTIFICATION_PLACEHOLDER=
# CLASSMARKER_PREMIUM_TEST_URL__ISACA_CERTIFICATION_PLACEHOLDER=
# CLASSMARKER_FREE_TEST_URL__PRINCE2_PLACEHOLDER=
# CLASSMARKER_PREMIUM_TEST_URL__PRINCE2_PLACEHOLDER=
# CLASSMARKER_FREE_TEST_URL__IT_CERTIFICATION_PLACEHOLDER=
# CLASSMARKER_PREMIUM_TEST_URL__IT_CERTIFICATION_PLACEHOLDER=
#
# Udemy URLs can be overridden the same way:
# UDEMY_URL__<SLUG>=
